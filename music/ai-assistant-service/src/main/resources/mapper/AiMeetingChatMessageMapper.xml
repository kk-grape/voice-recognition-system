<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.music.ai.mapper.AiMeetingChatMessageMapper">

    <resultMap id="BaseResultMap" type="com.music.ai.domain.AiMeetingChatMessage">
        <id column="id" property="id"/>
        <result column="session_id" property="sessionId"/>
        <result column="role" property="role"/>
        <result column="content" property="content"/>
        <result column="ai_skill" property="aiSkill"/>
        <result column="input_tokens" property="inputTokens"/>
        <result column="output_tokens" property="outputTokens"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" parameterType="com.music.ai.domain.AiMeetingChatMessage">
        INSERT INTO ai_meeting_chat_message (id, session_id, role, content, ai_skill, input_tokens, output_tokens, created_at)
        VALUES (#{id}, #{sessionId}, #{role}, #{content}, #{aiSkill}, #{inputTokens}, #{outputTokens}, #{createdAt})
    </insert>

    <select id="selectBySessionId" resultMap="BaseResultMap">
        SELECT * FROM ai_meeting_chat_message WHERE session_id = #{sessionId} ORDER BY created_at ASC
    </select>

</mapper>
